# Copy this file to .env and fill in real values for local development.
# On Railway, set these as Environment Variables in the dashboard.

# Django core
SECRET_KEY=your-long-random-secret-key-here
DEBUG=False
ALLOWED_HOSTS=yourdomain.up.railway.app,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://yourdomain.up.railway.app

# WheatGuard
MODEL_MODE=convnext
WEIGHTS_DIR=/app/weights
